FROM node:26.13.1-slim
WORKDIR /app
# The image's own manifest links the workspace packages to their folders under /app/packages, so
# Node loads them by their real paths: it does not strip types from files under node_modules.
COPY containers/codemod-react/package.json containers/codemod-react/package-lock.json ./
COPY packages/core ./packages/core
COPY packages/action-codemod ./packages/action-codemod
# npm does not know pnpm's `workspace:` dependencies, and test-utils is a devDependency only (not
# copied into the image): drop both from the packages' manifests, then install production deps.
# `npm ci` installs exactly what package-lock.json pins (it fails if the lockfile and manifests drift).
RUN node -e 'const fs = require("node:fs"); for (const dir of fs.readdirSync("packages")) { const file = `packages/${dir}/package.json`; const pkg = JSON.parse(fs.readFileSync(file, "utf8")); delete pkg.devDependencies; for (const [name, spec] of Object.entries(pkg.dependencies ?? {})) if (spec.startsWith("workspace:")) delete pkg.dependencies[name]; fs.writeFileSync(file, JSON.stringify(pkg, null, 2)); }' \
 && npm ci --omit=dev --no-audit --no-fund --no-update-notifier \
 && npm cache clean --force
# Which published codemod package this image carries (its transforms and their kinds are listed in
# packages/action-codemod/src/catalog.ts).
ENV CODEMOD_PACKAGE=react-codemod
WORKDIR /workspace
ENTRYPOINT ["node", "/app/packages/action-codemod/src/bin.ts"]
